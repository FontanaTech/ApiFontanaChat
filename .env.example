# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio.
NODE_ENV=development
HOST=0.0.0.0
PORT=10000

# Cadena de conexión de Neon (incluye ?sslmode=require). Sin valor real aquí.
DATABASE_URL=

# Secreto largo y aleatorio (>= 32 caracteres) para firmar hashes de sesiones.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Ollama: SOLO lo usa el backend.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT_MS=20000
# Mantiene el modelo cargado entre mensajes y fija la ventana de contexto (no la cambies entre peticiones).
OLLAMA_KEEP_ALIVE=12h
OLLAMA_NUM_CTX=8192

# Sesiones
ADMIN_SESSION_TTL_HOURS=8
PUBLIC_SESSION_TTL_MINUTES=120

# Límites
BODY_LIMIT_KB=16
CHAT_MESSAGE_MAX_CHARS=500
# Máximo de caracteres del sitio que se envían al modelo como contexto.
CHAT_CONTEXT_MAX_CHARS=16000
# Respuesta instantánea (sin modelo) cuando una sección del sitio cubre claramente la pregunta. 0 = siempre usar el modelo.
CHAT_FAST_SCORE=2
# Caché de empresa/orígenes/sesión pública (0 la desactiva).
PUBLIC_CACHE_TTL_SECONDS=15
CONTENT_MAX_BYTES=524288
CONTENT_FETCH_TIMEOUT_MS=8000

# Solo desarrollo: permite URLs de contenido en localhost/IP privada. Ignorado si NODE_ENV=production.
ALLOW_LOCAL_CONTENT_URLS=false

# Rate limit (peticiones por ventana por IP)
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_GENERAL=300
RATE_LIMIT_SESSIONS=30
RATE_LIMIT_CHAT=20
RATE_LIMIT_LOGIN=10

# Render/proxy: número de proxies de confianza
TRUST_PROXY=1

# Seed de AAgora (opcional). NO incluye números: se registran en el panel.
# AAGORA_ORIGINS=https://tu-dominio-aagora.example,http://localhost:5173
# AAGORA_CONTENT_URL=https://tu-dominio-aagora.example/chatbot-content.json
